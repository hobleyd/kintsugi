# ---- Build output ----
bin/
obj/
TestResults/
.dotnet-home/

# Rust agent build output (see also clients/macos-agent/.gitignore)
target/

# Release artifacts produced by clients/macos-agent/packaging/publish-release.sh —
# rebuild with cargo-zigbuild rather than committing them.
dist/

# Flutter/Dart build output and tool state for the admin UI in web/. build/ holds the compiled
# bundle nginx serves; it is produced by the Flutter stage of nginx/Dockerfile on every
# `docker compose build`, so committing it would only ever be a stale copy of that.
web/build/
web/.dart_tool/
web/.flutter-plugins
web/.flutter-plugins-dependencies
web/*.iml

# ---- IDE / editor ----
.vs/
.vscode/
.idea/
*.user
*.suo

# ---- macOS ----
.DS_Store
._*

# ---- Secrets & credential material — never committed ----
# Real values live in .env; .env.example is the committed template.
.env
.env.local
.env.*.local

# TLS private key material.
nginx/tls/
*.pem
*.key
*.pfx
*.p12
*.crt
secrets/

# ---- Local tooling state ----
.claude/scheduled_tasks.lock
.claude/settings.local.json
