# Copy this file to .env and fill in real values before running docker compose.
# .env is gitignored; never commit real credentials.

POSTGRES_DB=patching
POSTGRES_USER=patching_app
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Port exposed on the host for the nginx web layer (the only ingress point).
WEB_PORT=8080
# Port exposed on the host for TLS — this is what agents and browsers should actually use.
WEB_TLS_PORT=8443

# One-time secret a new agent presents to POST /api/host/enroll to get its client certificate
# (mutual TLS identity) and start being trusted. Generate with e.g. `openssl rand -hex 32`.
# Not needed again once an agent is enrolled; rotating it doesn't affect already-enrolled agents,
# only future enrollments.
AGENT_ENROLLMENT_TOKEN=

# The address agents call home on, baked into every package the Clients page imports. Set this to
# **nginx's own address and port** (the WEB_TLS_PORT one) — not the address you browse the admin UI
# on, if those differ.
#
# They differ whenever anything terminates TLS in front of nginx: a gateway, a load balancer, a CDN.
# nginx is what verifies the agent's client certificate, so a hop that ends the TLS handshake at
# itself cannot pass that certificate on, and an agent pointed there fails in the quietest way
# available — /api/host/enroll sits outside nginx's client-certificate regex on purpose, so the
# agent enrolls, looks installed, and then gets 403 on every authenticated route forever.
#
# Left blank, the Clients page falls back to the address it was reached on and says so on-screen.
# That is correct only for a deployment where nginx is the front door.
AGENT_API_BASE_URL=

# ASP.NET Core hosting environment for the API container.
ASPNETCORE_ENVIRONMENT=Production

# Ollama Web Search API key (https://ollama.com/settings/keys). Optional — when set, the
# Ollama upgrade-path research path gets a web_search tool instead of answering from training
# data alone. Leave blank to disable.
OLLAMA_WEB_API_KEY=

# GitHub personal access token (https://github.com/settings/tokens), no scopes needed — only used
# for public repository search and for reading this project's own releases. Optional: upgrade-path
# research searches GitHub for an application's identifier either way, but unauthenticated search
# is limited to 10 requests/minute across the whole system; set this to raise that limit if scans
# are hitting it. The Clients page's "Refresh clients" also reads releases anonymously without it.
GITHUB_API_TOKEN=

# Which repository the Clients page pulls kintsugi-agent builds from — its CI publishes one
# release per agent per version, and "Refresh clients" downloads them, rewrites api_base_url to
# this server's own address, and republishes them here. Optional: defaults to this project's own
# public repository. Set it to point at a fork or an internal mirror instead.
AGENT_PACKAGE_GITHUB_REPO=

# Only used if AiAgentSettings.Provider is set to GooseCli and the configured endpoint requires
# authentication. Goose is reached by running `goose serve` (ships in the standard goose CLI —
# start it with GOOSE_SERVER__SECRET_KEY=<value>, --host 0.0.0.0, --port <port>, and --tls
# recommended) on a machine reachable from this container's network (VPN, Tailscale, etc. — the
# API container just needs a route to it, no special sidecar). Set this to the same secret key
# value; sent as the X-Secret-Key header. Leave blank only if that goose serve instance was
# started with --dangerously-unauthenticated.
GOOSE_SERVE_SECRET_KEY=
