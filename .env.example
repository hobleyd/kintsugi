# Copy this file to .env and fill in real values before running docker compose.
# .env is gitignored; never commit real credentials.

POSTGRES_DB=patching
POSTGRES_USER=patching_app
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Port exposed on the host for the nginx web layer (the only ingress point).
WEB_PORT=8080
# Port exposed on the host for TLS — this is what agents and browsers should actually use.
WEB_TLS_PORT=8443

# One-time secret a new agent presents to POST /api/host/enroll to get its client certificate
# (mutual TLS identity) and start being trusted. Generate with e.g. `openssl rand -hex 32`.
# Not needed again once an agent is enrolled; rotating it doesn't affect already-enrolled agents,
# only future enrollments.
AGENT_ENROLLMENT_TOKEN=

# ASP.NET Core hosting environment for the API container.
ASPNETCORE_ENVIRONMENT=Production

# Ollama Web Search API key (https://ollama.com/settings/keys). Optional — when set, the
# Ollama upgrade-path research path gets a web_search tool instead of answering from training
# data alone. Leave blank to disable.
OLLAMA_WEB_API_KEY=

# GitHub personal access token (https://github.com/settings/tokens), no scopes needed — only used
# for public repository search. Optional: upgrade-path research searches GitHub for an
# application's identifier either way, but unauthenticated search is limited to 10 requests/minute
# across the whole system; set this to raise that limit if scans are hitting it.
GITHUB_API_TOKEN=

# Only used if AiAgentSettings.Provider is set to GooseCli and the configured endpoint requires
# authentication. Goose is reached by running `goose serve` (ships in the standard goose CLI —
# start it with GOOSE_SERVER__SECRET_KEY=<value>, --host 0.0.0.0, --port <port>, and --tls
# recommended) on a machine reachable from this container's network (VPN, Tailscale, etc. — the
# API container just needs a route to it, no special sidecar). Set this to the same secret key
# value; sent as the X-Secret-Key header. Leave blank only if that goose serve instance was
# started with --dangerously-unauthenticated.
GOOSE_SERVE_SECRET_KEY=
