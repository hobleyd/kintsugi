@page "/hosts"
@model Kintsugi.WebApi.Pages.HostsModel
@{
    ViewData["Title"] = "Registered Hosts";
    ViewData["ActiveNav"] = "hosts";
}

<p class="subtitle">@Model.Hosts.Count host(s) registered</p>

@if (Model.Hosts.Count == 0)
{
    <div class="panel">
        <p class="empty">No hosts have been registered yet. Register one via <code>POST /api/host</code>.</p>
    </div>
}
else
{
    <div class="panel table-panel">
        <table>
            <thead>
                <tr>
                    <th>Hostname</th>
                    <th>Serial Number</th>
                    <th>Operating System</th>
                    <th>OS Update</th>
                    <th class="count">App Updates</th>
                    <th>IP Address</th>
                    <th>Status</th>
                    <th>Last Seen</th>
                    <th class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var host in Model.Hosts)
                {
                    <tr data-host-id="@host.Id">
                        <td>@host.Hostname</td>
                        <td><code>@host.SerialNumber</code></td>
                        <td>@(host.OperatingSystem ?? "—")</td>
                        <td>
                            @if (host.OperatingSystemUpdateAvailable == true)
                            {
                                <span class="status status-update-available">Update Available</span>
                                @if (host.OperatingSystemLatestVersion is { } latestVersion)
                                {
                                    <div class="muted-text">@latestVersion</div>
                                }
                            }
                            else if (host.OperatingSystemUpdateAvailable == false)
                            {
                                <span class="status status-up-to-date">Up To Date</span>
                            }
                            else
                            {
                                <span class="status status-unknown">Not Checked</span>
                            }
                        </td>
                        <td class="count">
                            @if (host.AppUpdatesAvailableCount > 0)
                            {
                                <a class="count-badge count-badge-alert count-badge-link" href="/applications?status=update-available&host=@Uri.EscapeDataString(host.Hostname)" title="View applications requiring an update on @host.Hostname">@host.AppUpdatesAvailableCount</a>
                            }
                            else
                            {
                                <span class="count-badge">0</span>
                            }
                        </td>
                        <td>@(host.IpAddress ?? "—")</td>
                        <td><span class="status status-@host.Status.ToString().ToLowerInvariant()">@host.Status</span></td>
                        <td>
                            @if (host.LastSeenUtc is { } lastSeenUtc)
                            {
                                <time data-utc="@lastSeenUtc.ToString("o")">@lastSeenUtc.ToString("yyyy-MM-dd HH:mm") UTC</time>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td class="actions">
                            <button type="button" class="icon-btn icon-btn-danger remove-host-btn" data-host-id="@host.Id" data-hostname="@host.Hostname" aria-label="Remove @host.Hostname" title="Remove host">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path></svg>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<script>
    (function () {
        document.querySelectorAll('.remove-host-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var hostId = btn.getAttribute('data-host-id');
                var hostname = btn.getAttribute('data-hostname');

                if (!window.confirm('Remove ' + hostname + '? Its agent will be instructed to uninstall itself completely on its next check-in.')) {
                    return;
                }

                btn.disabled = true;

                fetch('/api/hosts/' + encodeURIComponent(hostId), { method: 'DELETE' })
                    .then(function (response) {
                        if (!response.ok) {
                            return response.text().then(function (text) {
                                var message = 'HTTP ' + response.status;
                                try {
                                    var problem = JSON.parse(text);
                                    message = problem.detail || problem.title || message;
                                } catch (parseErr) { /* not JSON — fall back to the status */ }
                                throw new Error(message);
                            });
                        }

                        // Server-rendered, so a reload is the simplest way to keep this page's
                        // markup (including the "N host(s) registered" count) in sync with it.
                        window.location.reload();
                    })
                    .catch(function (err) {
                        btn.disabled = false;
                        window.alert('Could not remove ' + hostname + ': ' + err.message);
                    });
            });
        });
    })();
</script>
