<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kintsugi</title>
    <link rel="icon" href="~/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/favicon-16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="~/img/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <partial name="_ThemeHead" />
</head>
<body>
    <div class="layout">
        @{
            var activeNav = ViewData["ActiveNav"] as string ?? string.Empty;
            var inSettings = activeNav == "settings" || activeNav.StartsWith("settings.");
        }
        <nav class="sidebar">
            <div class="brand">
                <img src="~/img/logo-nav.png" alt="" class="brand-logo">
                <span class="brand-name">Kintsugi</span>
            </div>
            <a href="/hosts" aria-current="@(activeNav == "hosts" ? "page" : null)">Hosts</a>
            <a href="/applications" aria-current="@(activeNav == "applications" ? "page" : null)">Applications</a>
            <a href="/upgrade-scripts" aria-current="@(activeNav == "upgrade-scripts" ? "page" : null)">Upgrade Scripts</a>
            <a href="/clients" aria-current="@(activeNav == "clients" ? "page" : null)">Clients</a>
            <a href="/settings/ai-agent" aria-current="@(inSettings ? "page" : null)">Settings</a>
            <div class="sidebar-subnav">
                <a class="sidebar-subnav-link" href="/settings/ai-agent" aria-current="@(activeNav == "settings.ai-agent" ? "page" : null)">AI Agent</a>
                <a class="sidebar-subnav-link" href="/settings/patching-policy" aria-current="@(activeNav == "settings.patching-policy" ? "page" : null)">Patching Policy</a>
                <a class="sidebar-subnav-link" href="/settings/authentication" aria-current="@(activeNav == "settings.authentication" ? "page" : null)">Authentication</a>
            </div>
            <div class="sidebar-footer">
                @* Labels and icons are swapped by CSS on :root[data-theme], not here, so the
                   button reads correctly before the handler at the foot of this file runs. *@
                <button type="button" id="theme-toggle" class="sidebar-theme-toggle">
                    <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                    </svg>
                    <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
                    </svg>
                    <span class="theme-label-light">Light mode</span>
                    <span class="theme-label-dark">Dark mode</span>
                </button>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="sidebar-account">
                        <span class="sidebar-account-name">@(User.Identity.Name ?? User.FindFirst("email")?.Value ?? "Signed in")</span>
                        <form method="post" action="/account/logout">
                            <button type="submit" class="sidebar-account-logout">Log out</button>
                        </form>
                    </div>
                }
            </div>
        </nav>
        <div class="wrap">
            <h1>@ViewData["Title"]</h1>
            @RenderBody()
        </div>
    </div>
    <script>
        // Flips the theme and remembers it. _ThemeHead.cshtml re-applies the stored value on
        // the next page load; site.css holds the :root[data-theme="light"] palette it selects.
        (function () {
            var toggle = document.getElementById('theme-toggle');
            if (!toggle) {
                return;
            }
            toggle.addEventListener('click', function () {
                var root = document.documentElement;
                var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
                root.setAttribute('data-theme', next);
                try {
                    localStorage.setItem('kintsugi-theme', next);
                } catch (e) {
                    // Storage blocked: the choice still applies until the next navigation.
                }
            });
        })();
    </script>
    <script>
        // Timestamps are rendered server-side in UTC (via data-utc, an ISO 8601 string) since the
        // server doesn't know the visitor's timezone — convert them to the browser's local time here.
        (function () {
            function pad(n) { return n < 10 ? '0' + n : String(n); }

            document.querySelectorAll('[data-utc]').forEach(function (el) {
                var raw = el.getAttribute('data-utc');
                if (!raw) {
                    return;
                }
                var date = new Date(raw);
                if (isNaN(date.getTime())) {
                    return;
                }
                el.textContent =
                    date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate()) +
                    ' ' + pad(date.getHours()) + ':' + pad(date.getMinutes());
            });
        })();
    </script>
</body>
</html>
