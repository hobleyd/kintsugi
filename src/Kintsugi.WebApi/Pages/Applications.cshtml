@page "/applications"
@model Kintsugi.WebApi.Pages.ApplicationsModel
@using Kintsugi.Domain.Enums
@using Kintsugi.Application.UpgradePaths
@{
    ViewData["Title"] = "Installed Applications";
    ViewData["ActiveNav"] = "applications";
}

<div class="section-header">
    <div>
        <h2>Upgrade Paths</h2>
        <p class="hint">
            "Find Upgrade Paths" resolves an update method for each installed application that
            doesn't have one yet — one at a time, in series. Homebrew-managed applications get a
            fixed, deterministic script inserted directly, with no AI call involved; everything else
            uses the configured AI agent to generate one. Either way, a freshly generated script
            still needs a human to review and "Sign Script" before an agent will run it. "Check for
            Updates" re-runs each existing script's own version check instead, with no AI call
            involved, to see whether a newer version has been released. Both run in the background —
            this page polls for progress rather than waiting on it.
        </p>
    </div>
    <div class="button-row">
        <button type="button" id="find-upgrade-paths-btn" class="btn-primary">Find Upgrade Paths</button>
        <button type="button" id="check-for-updates-btn" class="btn-secondary">Check for Updates</button>
    </div>
</div>

<div id="scan-progress" class="scan-progress" style="display: none;">
    <div class="scan-progress-bar"><div class="scan-progress-fill" id="scan-progress-fill"></div></div>
    <p class="hint" id="scan-progress-text"></p>
</div>
<div id="find-upgrade-paths-notes"></div>

<div id="update-check-progress" class="scan-progress" style="display: none;">
    <div class="scan-progress-bar"><div class="scan-progress-fill" id="update-check-progress-fill"></div></div>
    <p class="hint" id="update-check-progress-text"></p>
</div>
<div id="check-for-updates-notes"></div>

<p class="subtitle">@Model.TotalApplicationCount distinct application(s) reported across all hosts</p>

@{
    void RenderApplicationRow(ApplicationRowViewModel row, bool isChild)
    {
        var paths = row.UpgradePaths;
        var hostNamesAttr = string.Join("|", row.HostNames.Select(h => h.ToLowerInvariant()));
        if (paths.Count == 0)
        {
            <tr class="@(isChild ? "child-row" : null)" data-app-name="@row.Name" data-status="@UpgradePathStatusKey.NotChecked" data-hosts="@row.HostCount" data-host-names="@hostNamesAttr" data-platform="">
                <td>@row.Name</td>
                <td class="count"><span class="count-badge">@row.HostCount</span></td>
                <td class="muted-text">—</td>
                <td><span class="muted-text">Not checked yet</span></td>
                <td class="muted-text">—</td>
                <td class="muted-text">—</td>
                <td class="muted-text">—</td>
                <td class="actions">
                    <button type="button" class="icon-btn instructions-toggle-btn" data-application-name="@row.Name" data-platform="" aria-expanded="false" aria-label="Show AI instructions for @row.Name" title="AI instructions">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </button>
                </td>
            </tr>
        }
        else
        {
            foreach (var path in paths)
            {
                var statusKey = UpgradePathStatusKey.For(path);
                // Distinct from data-host-names ("this app is installed on this host" — used by
                // the host filter on its own): this is "this host specifically needs THIS update"
                // — used together with the Status filter so picking a host and "Update Available"
                // shows only what that host is actually behind on, not every app installed there
                // that some other host happens to be behind on too.
                var outdatedHostsAttr = string.Join("|", path.HostNamesNeedingUpdate.Select(h => h.ToLowerInvariant()));
                <tr class="@(isChild ? "child-row" : null)" data-app-name="@row.Name" data-status="@statusKey" data-hosts="@row.HostCount" data-host-names="@hostNamesAttr" data-outdated-hosts="@outdatedHostsAttr" data-platform="@path.Platform">
                    <td>@row.Name</td>
                    <td class="count"><span class="count-badge">@row.HostCount</span></td>
                    <td class="muted-text">@path.Platform</td>
                    <td>
                        @if (path.Status == UpgradePathStatus.Failed)
                        {
                            <span class="status status-check-failed">Check Failed</span>
                        }
                        else if (path.Status == UpgradePathStatus.NotFound)
                        {
                            <span class="status status-not-found">No Known Path</span>
                        }
                        else if (path.Method == UpgradeMethod.Script && path.Script is not null && path.ScriptSignature is null)
                        {
                            <span class="status status-review-sign">Review And Sign</span>
                        }
                        else if (path.UpdateAvailableHostCount > 0)
                        {
                            <span class="status status-update-available">Update Available</span>
                        }
                        else
                        {
                            <span class="status status-up-to-date">Up To Date</span>
                        }
                    </td>
                    <td>@(path.LatestVersion ?? "—")</td>
                    <td>
                        @if (path.Method == UpgradeMethod.DirectDownload && path.DownloadUrl is not null)
                        {
                            <a class="upgrade-link" href="@path.DownloadUrl" target="_blank" rel="noopener">Download</a>
                        }
                        else if (path.Method == UpgradeMethod.PackageManagerCommand && path.Command is not null)
                        {
                            <code>@path.Command</code>
                        }
                        else if (path.Method == UpgradeMethod.ManualSteps && path.Instructions is not null)
                        {
                            <details class="steps">
                                <summary>View steps</summary>
                                <pre>@path.Instructions</pre>
                            </details>
                        }
                        else if (path.Method == UpgradeMethod.Script && path.Script is not null)
                        {
                            <button type="button" class="link-btn script-view-btn" data-application-name="@row.Name" data-platform="@path.Platform" data-script="@path.Script">View script</button>
                        }
                        else
                        {
                            <span class="muted-text">@(path.Notes ?? "No reliable information found.")</span>
                        }
                        @if (path.SourceUrl is not null)
                        {
                            <div><a class="upgrade-link muted-text" href="@path.SourceUrl" target="_blank" rel="noopener">source</a></div>
                        }
                    </td>
                    <td class="muted-text"><time data-utc="@path.CheckedUtc.ToString("o")">@path.CheckedUtc.ToString("yyyy-MM-dd HH:mm") UTC</time></td>
                    <td class="actions">
                        <button type="button" class="icon-btn instructions-toggle-btn" data-application-name="@row.Name" data-platform="@path.Platform" aria-expanded="false" aria-label="Show AI instructions for @row.Name (@path.Platform)" title="AI instructions">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </button>
                    </td>
                </tr>
            }
        }
    }
}

@if (Model.Applications.Count == 0)
{
    <div class="panel">
        <p class="empty">No applications have been reported yet. Register some via <code>POST /api/applications</code>.</p>
    </div>
}
else
{
    <div class="panel table-panel">
        <div class="table-toolbar">
            <span class="hint">Search and filter from the column headers below.</span>
            <button type="button" id="app-clear-filters-btn" class="btn-secondary" style="display: none;">Clear Filters</button>
        </div>
        <table>
            <thead>
                <tr>
                    <th class="sortable" data-sort-col="0" data-sort-type="text">
                        <div class="th-sort-label">Application Name</div>
                        <input type="text" id="app-search-input" class="th-filter-input" placeholder="Search…" autocomplete="off" aria-label="Search application name" />
                    </th>
                    <th class="count sortable" data-sort-col="1" data-sort-type="number">
                        <div class="th-sort-label">Hosts Installed On</div>
                        <select id="app-host-filter" class="th-filter-input" aria-label="Filter by host">
                            <option value="all">All hosts</option>
                            @foreach (var host in Model.AllHostNames)
                            {
                                <option value="@host">@host</option>
                            }
                        </select>
                    </th>
                    <th class="sortable" data-sort-col="2" data-sort-type="text">
                        <div class="th-sort-label">Platform</div>
                    </th>
                    <th class="sortable" data-sort-col="3" data-sort-type="text">
                        <div class="th-sort-label">Status</div>
                        <select id="app-status-filter" class="th-filter-input" aria-label="Filter by status">
                            <option value="all">All statuses</option>
                            <option value="update-available">Update Available</option>
                            <option value="up-to-date">Up To Date</option>
                            <option value="review-sign">Review And Sign</option>
                            <option value="not-found">No Known Path</option>
                            <option value="check-failed">Check Failed</option>
                            <option value="not-checked">Not Checked Yet</option>
                        </select>
                    </th>
                    <th class="sortable" data-sort-col="4" data-sort-type="text">
                        <div class="th-sort-label">Latest</div>
                    </th>
                    <th>Upgrade</th>
                    <th class="sortable" data-sort-col="6" data-sort-type="text">
                        <div class="th-sort-label">Checked</div>
                    </th>
                    <th class="actions">Actions</th>
                </tr>
            </thead>
            <tbody id="applications-table-body">
                @foreach (var application in Model.Applications)
                {
                    RenderApplicationRow(application, false);
                    foreach (var child in application.Children)
                    {
                        RenderApplicationRow(child, true);
                    }
                }
            </tbody>
        </table>
    </div>
}

<div id="script-modal-backdrop" class="script-modal-backdrop" style="display: none;">
    <div class="script-modal" role="dialog" aria-modal="true" aria-labelledby="script-modal-title">
        <div class="script-modal-header">
            <h3 id="script-modal-title"></h3>
            <button type="button" id="script-modal-close" class="icon-btn" aria-label="Close">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>
        <pre id="script-modal-body" class="script-modal-body"></pre>
        <div class="script-modal-actions">
            <button type="button" id="script-modal-copy" class="btn-secondary">Copy to clipboard</button>
            <span id="script-modal-copy-status" class="muted-text"></span>
        </div>
    </div>
</div>

<script>
    (function () {
        function escapeHtml(value) {
            var div = document.createElement('div');
            div.textContent = value === null || value === undefined ? '' : String(value);
            return div.innerHTML;
        }

        function closePanel(row) {
            var next = row.nextElementSibling;
            if (next && next.classList.contains('instructions-row')) {
                next.remove();
            }
        }

        function resultHasScript(result) {
            return !!(result && typeof result.method === 'string' && result.method.toLowerCase() === 'script' && result.script);
        }

        // A script is only ever signable once it's actually present — a bare "found" result with
        // no script (e.g. still mid-generation, or a non-script method) has nothing to sign yet —
        // and only while it isn't already signed, so re-signing an untouched, already-approved
        // script isn't offered as if there were something new to review.
        function scriptIsSignable(result) {
            return resultHasScript(result) && !result.scriptSigned;
        }

        // Shows a script-method result as just its script — the thing there is to actually review
        // or replace — rather than that script buried as an escaped string inside a JSON envelope.
        // Anything else (no result yet, or a non-script method) keeps the full JSON, since there's
        // no single field that's obviously "the" content to isolate. Remembers the last result
        // rendered so a raw script pasted back in can be saved alongside whatever other fields
        // (applicationName, platform, notes, ...) it doesn't carry itself — see saveUpdateScript.
        function renderResultBox(panel, result) {
            panel._lastResult = result || null;
            var outputTextarea = panel.querySelector('.instructions-output-textarea');
            outputTextarea.value = resultHasScript(result)
                ? result.script
                : (result ? JSON.stringify(result, null, 2) : '');
            updateSignButtonAvailability(panel, result);
        }

        function findMatchingResult(results, platform) {
            if (!results || results.length === 0) {
                return null;
            }
            if (platform) {
                var match = results.filter(function (r) { return r.platform === platform; })[0];
                if (match) {
                    return match;
                }
            }
            return results[0];
        }

        // Reflects whether the "Sign Script" button should be usable right now. It only ever signs
        // whatever is already persisted server-side, so it's deliberately disabled the moment the
        // Update Script box is hand-edited (see the output textarea's 'input' listener below) — the
        // button re-enables again once a fresh AI result or a successful save brings the box back
        // in sync with what's actually stored.
        function updateSignButtonAvailability(panel, result) {
            var signBtn = panel.querySelector('.instructions-sign-btn');
            if (!signBtn) {
                return;
            }
            signBtn.disabled = !scriptIsSignable(result);
        }

        function sendInstructions(panel, applicationName) {
            var sendBtn = panel.querySelector('.instructions-send-btn');
            var textarea = panel.querySelector('.instructions-textarea');
            var statusEl = panel.querySelector('.instructions-status');
            var outputTextarea = panel.querySelector('.instructions-output-textarea');
            var platform = panel.dataset.resolvedPlatform || null;

            sendBtn.disabled = true;
            textarea.disabled = true;
            statusEl.textContent = 'Sending to AI…';
            outputTextarea.value = '';
            panel._lastResult = null;
            updateSignButtonAvailability(panel, null);

            fetch('/api/upgrade-paths/refresh', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ applicationName: applicationName, platform: platform, instructions: textarea.value })
            })
                .then(function (response) {
                    var isJson = (response.headers.get('content-type') || '').indexOf('application/json') !== -1;
                    if (!response.ok || !isJson) {
                        // A non-JSON body here is typically an nginx/proxy error page rather than
                        // anything the API itself returned — report that plainly instead of
                        // letting a raw JSON.parse failure bubble up as the error message.
                        throw new Error('HTTP ' + response.status + (response.statusText ? ' ' + response.statusText : ''));
                    }
                    return response.json();
                })
                .then(function (started) {
                    if (!started.started) {
                        sendBtn.disabled = false;
                        textarea.disabled = false;
                        statusEl.textContent = 'Already running — this application is already being refreshed.';
                        return;
                    }

                    pollRefreshStatus(panel, applicationName, sendBtn, textarea, statusEl, outputTextarea, Date.now());
                })
                .catch(function (err) {
                    sendBtn.disabled = false;
                    textarea.disabled = false;
                    statusEl.textContent = 'Failed.';
                    outputTextarea.value = JSON.stringify({ error: err.message }, null, 2);
                });
        }

        function pollRefreshStatus(panel, applicationName, sendBtn, textarea, statusEl, outputTextarea, startedAt) {
            fetch('/api/upgrade-paths/refresh-status?applicationName=' + encodeURIComponent(applicationName))
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                    }
                    return response.json();
                })
                .then(function (status) {
                    if (status.isRunning) {
                        statusEl.textContent = 'Researching… (' + Math.round((Date.now() - startedAt) / 1000) + 's)';
                        window.setTimeout(function () {
                            pollRefreshStatus(panel, applicationName, sendBtn, textarea, statusEl, outputTextarea, startedAt);
                        }, 3000);
                        return;
                    }

                    sendBtn.disabled = false;
                    textarea.disabled = false;

                    var result = status.result;
                    if (!result) {
                        statusEl.textContent = 'Failed.';
                        panel._lastResult = null;
                        outputTextarea.value = JSON.stringify({ error: 'No result was returned.' }, null, 2);
                        updateSignButtonAvailability(panel, null);
                        return;
                    }

                    statusEl.textContent = result.success ? 'Done.' : 'Failed.';

                    // The AI research flow persists straight to the database as soon as it
                    // finishes (see ResearchApplicationUpgradePathCommandHandler) — always
                    // unsigned, so a freshly generated script is immediately reviewable and
                    // signable here without a separate "Save Script" step in between.
                    var matched = findMatchingResult(result.results, panel.dataset.resolvedPlatform);
                    if (matched) {
                        renderResultBox(panel, matched);
                    } else {
                        // Nothing matched this panel's platform (e.g. the run failed outright) —
                        // fall back to showing whatever the whole response was, since there's no
                        // single item to isolate.
                        panel._lastResult = null;
                        outputTextarea.value = JSON.stringify(result, null, 2);
                        updateSignButtonAvailability(panel, null);
                    }
                })
                .catch(function (err) {
                    sendBtn.disabled = false;
                    textarea.disabled = false;
                    statusEl.textContent = 'Failed.';
                    outputTextarea.value = JSON.stringify({ error: err.message }, null, 2);
                    updateSignButtonAvailability(panel, null);
                });
        }

        function saveUpdateScript(panel, applicationName, platformFallback) {
            var saveBtn = panel.querySelector('.instructions-save-btn');
            var outputTextarea = panel.querySelector('.instructions-output-textarea');
            var statusEl = panel.querySelector('.instructions-save-status');

            var parsed;
            try {
                parsed = JSON.parse(outputTextarea.value);

                // Accept either a bare result, or the envelope a "Send to AI" response comes back
                // as ({ success, results: [...] }) — so a response copied straight out of this
                // same box can be pasted back in unchanged.
                if (parsed && Array.isArray(parsed.results) && parsed.results.length > 0 && !parsed.applicationName) {
                    parsed = parsed.results[0];
                }
            } catch (err) {
                // Not JSON — for a script-method result the box shows (and accepts) just the raw
                // script rather than the JSON envelope it lives in, so this is a script paste:
                // replace the script on whatever result was last shown here, keeping every other
                // already-known field (platform, notes, latest version, ...) as-is.
                parsed = Object.assign({}, panel._lastResult, {
                    method: 'Script',
                    script: outputTextarea.value
                });
            }

            if (!parsed || !parsed.applicationName) {
                parsed = Object.assign({}, parsed, { applicationName: applicationName });
            }
            if (!parsed.platform) {
                parsed.platform = panel.dataset.resolvedPlatform || platformFallback || null;
            }

            saveBtn.disabled = true;
            statusEl.textContent = 'Saving…';

            fetch('/api/upgrade-paths/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(parsed)
            })
                .then(function (response) {
                    if (!response.ok) {
                        return response.text().then(function (text) {
                            var message = 'HTTP ' + response.status;
                            try {
                                var problem = JSON.parse(text);
                                message = problem.detail || problem.title || message;
                            } catch (parseErr) { /* not JSON — fall back to the status */ }
                            throw new Error(message);
                        });
                    }
                    return response.json();
                })
                .then(function (result) {
                    saveBtn.disabled = false;
                    statusEl.textContent = 'Saved.';
                    renderResultBox(panel, result);

                    // Refresh the table with what was just saved — server-rendered, so a reload is
                    // the simplest way to keep this page's markup as the single source of truth for it.
                    window.setTimeout(function () { window.location.reload(); }, 1500);
                })
                .catch(function (err) {
                    saveBtn.disabled = false;
                    statusEl.textContent = 'Failed: ' + err.message;
                });
        }

        function signScript(panel, applicationName) {
            var signBtn = panel.querySelector('.instructions-sign-btn');
            var signStatusEl = panel.querySelector('.instructions-sign-status');
            var platform = panel.dataset.resolvedPlatform || null;

            signBtn.disabled = true;
            signStatusEl.textContent = 'Signing…';

            fetch('/api/upgrade-paths/sign-script', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ applicationName: applicationName, platform: platform })
            })
                .then(function (response) {
                    if (!response.ok) {
                        return response.text().then(function (text) {
                            var message = 'HTTP ' + response.status;
                            try {
                                var problem = JSON.parse(text);
                                message = problem.detail || problem.title || message;
                            } catch (parseErr) { /* not JSON — fall back to the status */ }
                            throw new Error(message);
                        });
                    }
                    return response.json();
                })
                .then(function (result) {
                    signStatusEl.innerHTML = 'Signed. ' + describeApprovalOutcome(result);

                    // Refresh the table so the Status column drops out of "Review And Sign" —
                    // server-rendered, so a reload is the simplest way to keep this page's markup
                    // as the single source of truth for it. Long enough to actually read the
                    // approval outcome above before the page reloads out from under it.
                    window.setTimeout(function () { window.location.reload(); }, 4000);
                })
                .catch(function (err) {
                    signBtn.disabled = false;
                    signStatusEl.textContent = 'Failed: ' + err.message;
                });
        }

        // Signing always saves the local signature regardless of what happens here — see
        // SignUpgradePathScriptCommandHandler — so this only ever explains the *publishing* half,
        // never contradicts "Signed." above it.
        function describeApprovalOutcome(result) {
            switch (result.approvalOutcome) {
                case 'PullRequestOpened':
                    return 'Opened <a href="' + escapeHtml(result.approvalPullRequestUrl) + '" target="_blank" rel="noopener">a pull request</a> for review.';
                case 'PullRequestAlreadyOpen':
                    return 'Already proposed in <a href="' + escapeHtml(result.approvalPullRequestUrl) + '" target="_blank" rel="noopener">an open pull request</a> — nothing new to raise.';
                case 'AlreadyApproved':
                    return 'This exact script is already approved on the default branch — nothing new to raise.';
                case 'Disabled':
                    return '<span class="muted-text">No pull request raised: ' + escapeHtml(result.approvalMessage || 'no script-approval token is configured.') + '</span>';
                case 'Failed':
                    return '<span class="muted-text">Publishing to GitHub failed: ' + escapeHtml(result.approvalMessage || 'unknown error.') + '</span>';
                default:
                    return '';
            }
        }

        function resumeRefreshIfRunning(panel, applicationName) {
            fetch('/api/upgrade-paths/refresh-status?applicationName=' + encodeURIComponent(applicationName))
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                    }
                    return response.json();
                })
                .then(function (status) {
                    if (!status.isRunning) {
                        return;
                    }

                    var sendBtn = panel.querySelector('.instructions-send-btn');
                    var textarea = panel.querySelector('.instructions-textarea');
                    var statusEl = panel.querySelector('.instructions-status');
                    var outputTextarea = panel.querySelector('.instructions-output-textarea');

                    sendBtn.disabled = true;
                    textarea.disabled = true;

                    // Use the server's recorded start time, not "now", so elapsed seconds stays
                    // accurate even though this panel was only just (re)created.
                    var startedAt = status.startedUtc ? new Date(status.startedUtc).getTime() : Date.now();
                    pollRefreshStatus(panel, applicationName, sendBtn, textarea, statusEl, outputTextarea, startedAt);
                })
                .catch(function () { /* transient — panel just stays in its idle default state */ });
        }

        // Lets the AI Instructions / Update Script split be dragged wider or narrower so either box
        // can be made big enough to actually read its contents, rather than being stuck at a fixed
        // 50/50 split. Sets explicit pixel flex-bases on both columns (rather than just the one
        // being dragged) so the divider tracks the pointer exactly instead of drifting.
        function enableColumnResize(panel) {
            var columns = panel.querySelector('.instructions-columns');
            var resizer = panel.querySelector('.instructions-resizer');
            var left = panel.querySelector('.instructions-editor');
            var right = panel.querySelector('.instructions-result');
            if (!columns || !resizer || !left || !right) {
                return;
            }

            var MIN_WIDTH_PX = 200;

            resizer.addEventListener('mousedown', function (event) {
                event.preventDefault();

                var columnsRect = columns.getBoundingClientRect();
                var resizerWidth = resizer.getBoundingClientRect().width;
                var startX = event.clientX;
                var startLeftWidth = left.getBoundingClientRect().width;
                var maxLeftWidth = columnsRect.width - resizerWidth - MIN_WIDTH_PX;

                function onMouseMove(moveEvent) {
                    var newLeftWidth = startLeftWidth + (moveEvent.clientX - startX);
                    newLeftWidth = Math.max(MIN_WIDTH_PX, Math.min(maxLeftWidth, newLeftWidth));
                    left.style.flex = '0 0 ' + newLeftWidth + 'px';
                    right.style.flex = '1 1 auto';
                }

                function onMouseUp() {
                    document.removeEventListener('mousemove', onMouseMove);
                    document.removeEventListener('mouseup', onMouseUp);
                }

                document.addEventListener('mousemove', onMouseMove);
                document.addEventListener('mouseup', onMouseUp);
            });
        }

        function openPanel(btn, row) {
            var applicationName = btn.getAttribute('data-application-name');
            var platform = btn.getAttribute('data-platform') || '';

            var panelRow = document.createElement('tr');
            panelRow.className = 'instructions-row';
            var cell = document.createElement('td');
            cell.colSpan = row.children.length;
            cell.innerHTML = '<div class="instructions-panel"><p class="muted-text">Loading default instructions…</p></div>';
            panelRow.appendChild(cell);
            row.parentNode.insertBefore(panelRow, row.nextSibling);

            var panel = cell.querySelector('.instructions-panel');
            var query = 'applicationName=' + encodeURIComponent(applicationName) + (platform ? '&platform=' + encodeURIComponent(platform) : '');

            fetch('/api/upgrade-paths/prompt?' + query)
                .then(function (response) { return response.json(); })
                .then(function (prompt) {
                    panel.dataset.resolvedPlatform = prompt.platform || platform || '';

                    var platformNote = prompt.platform ? ' <span class="muted-text">(platform: ' + escapeHtml(prompt.platform) + ')</span>' : '';
                    var editorHtml = prompt.available
                        ? '<div class="instructions-editor">' +
                            '<label class="instructions-label">AI instructions' + platformNote + '</label>' +
                            '<textarea class="instructions-textarea" rows="14" spellcheck="false"></textarea>' +
                            '<div class="instructions-actions">' +
                                '<button type="button" class="btn-secondary instructions-send-btn">Send to AI</button>' +
                                '<span class="instructions-status muted-text"></span>' +
                            '</div>' +
                          '</div>'
                        : '<div class="instructions-editor">' +
                            '<label class="instructions-label">AI instructions' + platformNote + '</label>' +
                            '<p class="muted-text"></p>' +
                          '</div>';

                    panel.innerHTML =
                        '<div class="instructions-columns">' +
                            editorHtml +
                            '<div class="instructions-resizer" title="Drag to resize"></div>' +
                            '<div class="instructions-result">' +
                                '<label class="instructions-label">Update Script</label>' +
                                '<textarea class="instructions-output-textarea" rows="14" spellcheck="false" placeholder="Paste a result JSON here to save it directly, without going through the AI — or, for a script-based result, just paste a replacement script."></textarea>' +
                                '<div class="instructions-actions">' +
                                    '<button type="button" class="btn-secondary instructions-save-btn">Save Script</button>' +
                                    '<span class="instructions-save-status muted-text"></span>' +
                                    '<button type="button" class="btn-secondary instructions-sign-btn" disabled title="Sign the saved script so an agent will run it">Sign Script</button>' +
                                    '<span class="instructions-sign-status muted-text"></span>' +
                                '</div>' +
                            '</div>' +
                        '</div>';

                    if (prompt.available) {
                        panel.querySelector('.instructions-textarea').value = prompt.prompt || '';
                        panel.querySelector('.instructions-send-btn').addEventListener('click', function () {
                            sendInstructions(panel, applicationName);
                        });
                    } else {
                        panel.querySelector('.instructions-editor p').textContent = prompt.reason || 'No AI instructions apply to this application.';
                    }

                    // An already-successful check shows up here by default, rather than leaving the
                    // box looking empty until someone re-runs the AI unnecessarily.
                    renderResultBox(panel, prompt.existingResult);

                    panel.querySelector('.instructions-save-btn').addEventListener('click', function () {
                        saveUpdateScript(panel, applicationName, platform);
                    });

                    panel.querySelector('.instructions-sign-btn').addEventListener('click', function () {
                        signScript(panel, applicationName);
                    });

                    // The sign button only ever signs what's already persisted — the moment the box
                    // is hand-edited it may no longer match that, so disable signing until the next
                    // AI result or successful save brings it back in sync.
                    panel.querySelector('.instructions-output-textarea').addEventListener('input', function () {
                        panel.querySelector('.instructions-sign-status').textContent = '';
                        updateSignButtonAvailability(panel, null);
                    });

                    enableColumnResize(panel);

                    // A "Send to AI" call started before this panel existed (e.g. the page was
                    // navigated away from and back) leaves the background job running with nothing
                    // in this fresh panel reflecting it — check for one and resume showing progress
                    // instead of looking idle while it's still working.
                    if (prompt.available) {
                        resumeRefreshIfRunning(panel, applicationName);
                    }
                })
                .catch(function (err) {
                    panel.innerHTML = '<p class="muted-text">Could not load instructions: ' + escapeHtml(err.message) + '</p>';
                });
        }

        var scriptModalBackdrop = document.getElementById('script-modal-backdrop');
        var scriptModalTitle = document.getElementById('script-modal-title');
        var scriptModalBody = document.getElementById('script-modal-body');
        var scriptModalCopyBtn = document.getElementById('script-modal-copy');
        var scriptModalCopyStatus = document.getElementById('script-modal-copy-status');
        var scriptModalCloseBtn = document.getElementById('script-modal-close');

        function openScriptModal(applicationName, platform, script) {
            scriptModalTitle.textContent = applicationName + (platform ? ' (' + platform + ')' : '');
            scriptModalBody.textContent = script;
            scriptModalCopyStatus.textContent = '';
            scriptModalBackdrop.style.display = 'flex';
        }

        function closeScriptModal() {
            scriptModalBackdrop.style.display = 'none';
        }

        document.querySelectorAll('.script-view-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                openScriptModal(
                    btn.getAttribute('data-application-name'),
                    btn.getAttribute('data-platform'),
                    btn.getAttribute('data-script') || '');
            });
        });

        scriptModalCloseBtn.addEventListener('click', closeScriptModal);
        scriptModalBackdrop.addEventListener('click', function (event) {
            if (event.target === scriptModalBackdrop) {
                closeScriptModal();
            }
        });
        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && scriptModalBackdrop.style.display !== 'none') {
                closeScriptModal();
            }
        });

        scriptModalCopyBtn.addEventListener('click', function () {
            var text = scriptModalBody.textContent;
            var reportCopied = function () {
                scriptModalCopyStatus.textContent = 'Copied.';
                window.setTimeout(function () { scriptModalCopyStatus.textContent = ''; }, 2000);
            };
            var reportFailed = function () {
                scriptModalCopyStatus.textContent = 'Could not copy — select the text and copy manually.';
            };

            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text).then(reportCopied, reportFailed);
                return;
            }

            // Fallback for non-secure contexts (e.g. plain-HTTP LAN access) where the async
            // Clipboard API is unavailable — select the text in a hidden textarea and use the
            // legacy synchronous copy command instead.
            var helper = document.createElement('textarea');
            helper.value = text;
            helper.style.position = 'fixed';
            helper.style.opacity = '0';
            document.body.appendChild(helper);
            helper.focus();
            helper.select();
            try {
                document.execCommand('copy') ? reportCopied() : reportFailed();
            } catch (err) {
                reportFailed();
            }
            document.body.removeChild(helper);
        });

        document.querySelectorAll('.instructions-toggle-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var row = btn.closest('tr');
                var next = row.nextElementSibling;
                var isOpen = next && next.classList.contains('instructions-row');

                if (isOpen) {
                    closePanel(row);
                    btn.classList.remove('expanded');
                    btn.setAttribute('aria-expanded', 'false');
                    return;
                }

                btn.classList.add('expanded');
                btn.setAttribute('aria-expanded', 'true');
                openPanel(btn, row);
            });
        });
    })();

    (function () {
        // Drives one "start a background run, poll its status, react when it finishes" button —
        // shared by "Find Upgrade Paths" (scan) and "Check for Updates" (update-check), which are
        // otherwise identical in shape and differ only in URLs, labels, and status field names.
        function createRunController(options) {
            var btn = document.getElementById(options.buttonId);
            var progressEl = document.getElementById(options.progressId);
            var progressFillEl = document.getElementById(options.progressFillId);
            var progressTextEl = document.getElementById(options.progressTextId);
            var notesEl = document.getElementById(options.notesId);
            var POLL_INTERVAL_MS = 3000;
            var pollHandle = null;
            var weStartedThisRun = false;

            function clearNotes() {
                notesEl.innerHTML = '';
            }

            function showAlert(className, text) {
                var box = document.createElement('div');
                box.className = 'alert ' + className;
                box.textContent = text;
                notesEl.appendChild(box);
                return box;
            }

            function renderNotes(notes) {
                if (!notes || notes.length === 0) {
                    return;
                }
                var box = showAlert('alert-info', '');
                var title = document.createElement('p');
                title.style.margin = '0 0 0.5rem';
                title.textContent = 'Worth a look:';
                box.appendChild(title);

                var list = document.createElement('ul');
                notes.forEach(function (note) {
                    var item = document.createElement('li');
                    item.textContent = note;
                    list.appendChild(item);
                });
                box.appendChild(list);
            }

            function setRunningUi(running) {
                btn.disabled = running;
                btn.textContent = running ? options.runningLabel : options.idleLabel;
                progressEl.style.display = running ? '' : 'none';
            }

            function renderStatus(status) {
                setRunningUi(status.isRunning);

                if (status.isRunning) {
                    var pct = status.total > 0 ? Math.round((status.completed / status.total) * 100) : 0;
                    progressFillEl.style.width = pct + '%';
                    progressTextEl.textContent = options.progressText(status);
                    return;
                }

                stopPolling();

                if (!weStartedThisRun) {
                    return;
                }
                weStartedThisRun = false;

                clearNotes();

                if (status.faultReason) {
                    showAlert('alert-error', status.faultReason);
                    return;
                }

                showAlert('alert-success', options.summaryText(status));
                renderNotes(status.notes);

                // Refresh the table with whatever the run found — server-rendered, so a reload is
                // the simplest way to keep this page's markup as the single source of truth for it.
                window.setTimeout(function () { window.location.reload(); }, 1500);
            }

            function poll() {
                fetch(options.statusUrl)
                    .then(function (response) { return response.json(); })
                    .then(renderStatus)
                    .catch(function () { /* transient — next poll will retry */ });
            }

            function startPolling() {
                if (pollHandle) {
                    return;
                }
                poll();
                pollHandle = window.setInterval(poll, POLL_INTERVAL_MS);
            }

            function stopPolling() {
                if (pollHandle) {
                    window.clearInterval(pollHandle);
                    pollHandle = null;
                }
            }

            btn.addEventListener('click', function () {
                clearNotes();
                fetch(options.startUrl, { method: 'POST' })
                    .then(function (response) { return response.json(); })
                    .then(function (result) {
                        weStartedThisRun = true;
                        if (!result.started) {
                            showAlert('alert-info', options.alreadyRunningText);
                        }
                        renderStatus(result.status);
                        startPolling();
                    })
                    .catch(function (err) {
                        showAlert('alert-error', 'Could not start: ' + err.message);
                    });
            });

            // A run kicked off from another tab, or before this page loaded, should still show
            // live progress here rather than looking idle.
            fetch(options.statusUrl)
                .then(function (response) { return response.json(); })
                .then(function (status) {
                    if (status.isRunning) {
                        weStartedThisRun = true;
                        renderStatus(status);
                        startPolling();
                    }
                })
                .catch(function () { /* ignore — button stays in its idle default state */ });
        }

        createRunController({
            buttonId: 'find-upgrade-paths-btn',
            progressId: 'scan-progress',
            progressFillId: 'scan-progress-fill',
            progressTextId: 'scan-progress-text',
            notesId: 'find-upgrade-paths-notes',
            startUrl: '/api/upgrade-paths/scan',
            statusUrl: '/api/upgrade-paths/scan-status',
            idleLabel: 'Find Upgrade Paths',
            runningLabel: 'Scan Running…',
            alreadyRunningText: 'A scan was already running — showing its progress.',
            progressText: function (status) {
                return status.completed + ' / ' + status.total + ' checked · ' +
                    status.resolved + ' resolved · ' + status.notFound + ' no known path · ' +
                    status.failed + ' failed · ' + status.skipped + ' already known';
            },
            summaryText: function (status) {
                return status.resolved + ' resolved, ' + status.notFound + ' with no known path, ' +
                    status.failed + ' failed, ' + status.skipped + ' already known.';
            }
        });

        createRunController({
            buttonId: 'check-for-updates-btn',
            progressId: 'update-check-progress',
            progressFillId: 'update-check-progress-fill',
            progressTextId: 'update-check-progress-text',
            notesId: 'check-for-updates-notes',
            startUrl: '/api/upgrade-paths/check-updates',
            statusUrl: '/api/upgrade-paths/check-updates-status',
            idleLabel: 'Check for Updates',
            runningLabel: 'Checking…',
            alreadyRunningText: 'A check was already running — showing its progress.',
            progressText: function (status) {
                return status.completed + ' / ' + status.total + ' checked · ' +
                    status.updated + ' updated · ' + status.unchanged + ' unchanged · ' +
                    status.failed + ' failed';
            },
            summaryText: function (status) {
                return status.updated + ' updated, ' + status.unchanged + ' unchanged, ' +
                    status.failed + ' failed.';
            }
        });
    })();

    (function () {
        // Client-side search/status filtering and column sorting for the applications table.
        // Everything the table needs is already server-rendered into each <tr>'s data attributes,
        // so there's no round trip: this just shows/hides and reorders rows already in the DOM.
        var tbody = document.getElementById('applications-table-body');
        if (!tbody) {
            return;
        }

        var searchInput = document.getElementById('app-search-input');
        var statusSelect = document.getElementById('app-status-filter');
        var hostSelect = document.getElementById('app-host-filter');
        var clearBtn = document.getElementById('app-clear-filters-btn');
        var sortableHeaders = Array.prototype.slice.call(document.querySelectorAll('th.sortable'));
        var NO_RESULTS_ROW_ID = 'app-no-results-row';
        var currentSort = null; // { col: number, type: 'text'|'number', dir: 1|-1 }

        function baseRows() {
            return Array.prototype.slice.call(tbody.querySelectorAll('tr[data-app-name]'));
        }

        // Sorting/filtering would otherwise leave a stale, orphaned instructions panel (or one out
        // of sync with the row it was opened from) sitting mid-table — simplest is to just close
        // any that are open whenever the table's row order or visibility changes.
        function closeAllInstructionPanels() {
            Array.prototype.slice.call(tbody.querySelectorAll('tr.instructions-row')).forEach(function (row) {
                row.remove();
            });
            Array.prototype.slice.call(document.querySelectorAll('.instructions-toggle-btn.expanded')).forEach(function (btn) {
                btn.classList.remove('expanded');
                btn.setAttribute('aria-expanded', 'false');
            });
        }

        function removeNoResultsRow() {
            var existing = document.getElementById(NO_RESULTS_ROW_ID);
            if (existing) {
                existing.remove();
            }
        }

        function showNoResultsRow(colCount) {
            removeNoResultsRow();
            var row = document.createElement('tr');
            row.id = NO_RESULTS_ROW_ID;
            var cell = document.createElement('td');
            cell.colSpan = colCount;
            cell.className = 'empty';
            cell.textContent = 'No applications match the current filters.';
            row.appendChild(cell);
            tbody.appendChild(row);
        }

        function hasActiveFilters() {
            return searchInput.value.trim() !== '' || statusSelect.value !== 'all' || hostSelect.value !== 'all';
        }

        function applyFilters() {
            var searchTerm = searchInput.value.trim().toLowerCase();
            var statusValue = statusSelect.value;
            var hostValue = hostSelect.value.toLowerCase();
            var visibleCount = 0;
            var headerColCount = document.querySelectorAll('thead th').length;

            baseRows().forEach(function (row) {
                var matchesSearch = !searchTerm || row.dataset.appName.toLowerCase().indexOf(searchTerm) !== -1;
                var matchesStatus = statusValue === 'all' || row.dataset.status === statusValue;

                // "Update Available" status is fleet-wide (true if ANY host is behind), so a plain
                // "installed on this host" check would also surface apps this host is already
                // current on, just because some other host isn't. Narrow to hosts specifically
                // behind on this application when both filters are active together.
                var matchesHost;
                if (hostValue === 'all') {
                    matchesHost = true;
                } else if (statusValue === 'update-available') {
                    var outdatedHosts = row.dataset.outdatedHosts ? row.dataset.outdatedHosts.split('|') : [];
                    matchesHost = outdatedHosts.indexOf(hostValue) !== -1;
                } else {
                    var hostNames = row.dataset.hostNames ? row.dataset.hostNames.split('|') : [];
                    matchesHost = hostNames.indexOf(hostValue) !== -1;
                }

                var visible = matchesSearch && matchesStatus && matchesHost;
                row.style.display = visible ? '' : 'none';
                if (visible) {
                    visibleCount += 1;
                }
            });

            if (visibleCount === 0) {
                showNoResultsRow(headerColCount);
            } else {
                removeNoResultsRow();
            }

            clearBtn.style.display = hasActiveFilters() ? '' : 'none';
        }

        function updateSortIndicators() {
            sortableHeaders.forEach(function (th) {
                th.classList.remove('sort-asc', 'sort-desc');
                if (currentSort && Number(th.dataset.sortCol) === currentSort.col) {
                    th.classList.add(currentSort.dir === 1 ? 'sort-asc' : 'sort-desc');
                }
            });
        }

        function cellValue(row, col, type) {
            var text = (row.children[col].textContent || '').trim();
            if (type === 'number') {
                var parsed = parseInt(text.replace(/[^0-9-]/g, ''), 10);
                return isNaN(parsed) ? 0 : parsed;
            }
            return text.toLowerCase();
        }

        function sortBy(col, type) {
            closeAllInstructionPanels();

            var dir = currentSort && currentSort.col === col ? -currentSort.dir : 1;
            currentSort = { col: col, type: type, dir: dir };

            var rows = baseRows();
            rows.sort(function (a, b) {
                var aVal = cellValue(a, col, type);
                var bVal = cellValue(b, col, type);
                if (aVal < bVal) return -1 * dir;
                if (aVal > bVal) return 1 * dir;
                return 0;
            });
            rows.forEach(function (row) { tbody.appendChild(row); });

            updateSortIndicators();
            applyFilters();
        }

        // Sort click target is the label div rather than the whole <th>, since each sortable
        // header now also hosts a filter input/select that shouldn't trigger a sort when clicked.
        sortableHeaders.forEach(function (th) {
            var label = th.querySelector('.th-sort-label');
            if (!label) {
                return;
            }
            label.addEventListener('click', function () {
                sortBy(Number(th.dataset.sortCol), th.dataset.sortType);
            });
        });

        searchInput.addEventListener('input', function () {
            closeAllInstructionPanels();
            applyFilters();
        });

        statusSelect.addEventListener('change', function () {
            closeAllInstructionPanels();
            applyFilters();
        });

        hostSelect.addEventListener('change', function () {
            closeAllInstructionPanels();
            applyFilters();
        });

        clearBtn.addEventListener('click', function () {
            searchInput.value = '';
            statusSelect.value = 'all';
            hostSelect.value = 'all';
            closeAllInstructionPanels();
            applyFilters();

            // Drop ?status=... (and any other filter params) from the URL so a refresh doesn't
            // silently reapply a filter the user just asked to clear.
            var url = new URL(window.location.href);
            url.search = '';
            window.history.replaceState({}, '', url.toString());
        });

        // Deep link from the Hosts page ("N" App Updates → here, pre-filtered) — and generally
        // lets any bookmarked/shared link with ?status=... land on the same filtered view.
        var requestedStatus = new URLSearchParams(window.location.search).get('status');
        if (requestedStatus && Array.prototype.some.call(statusSelect.options, function (opt) { return opt.value === requestedStatus; })) {
            statusSelect.value = requestedStatus;
        }

        // Same deep-link pattern for ?host=..., e.g. from a host's "N App Updates" badge on the
        // Hosts page. Matched case-insensitively, but assigned using the option's own casing —
        // <select>.value assignment is case-sensitive, so a query param that doesn't exactly match
        // the stored hostname's case would otherwise silently select nothing.
        var requestedHost = new URLSearchParams(window.location.search).get('host');
        if (requestedHost) {
            var matchedHostOption = Array.prototype.filter.call(hostSelect.options, function (opt) {
                return opt.value.toLowerCase() === requestedHost.toLowerCase();
            })[0];
            if (matchedHostOption) {
                hostSelect.value = matchedHostOption.value;
            }
        }

        applyFilters();
    })();
</script>
