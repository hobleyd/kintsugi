@page "/settings/ai-agent"
@model Kintsugi.WebApi.Pages.Settings.AiAgentModel
@using Kintsugi.Domain.Enums
@{
    ViewData["Title"] = "AI Agent";
    ViewData["ActiveNav"] = "settings.ai-agent";
}

<p class="subtitle">Connect the patching system to an AI agent to power automated triage and remediation suggestions.</p>

@if (!Model.ModelState.IsValid)
{
    <div class="alert alert-error">
        <ul>
            @foreach (var error in Model.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

@if (Model.SaveSucceeded)
{
    <div class="alert alert-success">Settings saved.</div>
}

<div class="panel">
    <form method="post" class="settings-form">
        <div class="field">
            <label for="provider">Provider</label>
            <select id="provider" asp-for="Input.Provider">
                <option value="@AiProvider.Anthropic">Anthropic (Claude)</option>
                <option value="@AiProvider.OpenAI">OpenAI</option>
                <option value="@AiProvider.Ollama">Local LLM (Ollama)</option>
                <option value="@AiProvider.GooseCli">Goose CLI</option>
            </select>
        </div>

        <div class="field" data-provider-field="cloud">
            <label for="apiKey">API Key</label>
            <input type="password" id="apiKey" asp-for="Input.ApiKey" autocomplete="off"
                   placeholder="@(Model.HasApiKey ? "•••••••••••• (leave blank to keep current key)" : "sk-...")" />
            @if (Model.HasApiKey)
            {
                <p class="hint">An API key is already configured. Leave blank to keep it.</p>
            }
        </div>

        <div class="field" data-provider-field="localbin">
            <label for="baseUrl" id="baseUrlLabel">Endpoint URL</label>
            <div class="model-select-row">
                <input type="text" id="baseUrl" asp-for="Input.BaseUrl" placeholder="http://localhost:11434" />
                <button type="button" id="check-goose-btn" class="btn-secondary" data-provider-field="goose">Check</button>
            </div>
            <p class="hint" id="goose-status" data-provider-field="goose"></p>
            <p class="hint" data-provider-field="goose">The base URL of a `goose serve` instance reachable from this server. Leave blank to use Goose's own default local address.</p>
        </div>

        <div class="field">
            <label for="model">Model</label>
            <input type="text" id="model" asp-for="Input.Model" data-provider-field="text-model"
                   placeholder="e.g. claude-opus-4-6, gpt-5" />
            <div class="model-select-row" data-provider-field="ollama-model">
                <select id="model-select"></select>
                <button type="button" id="refresh-models-btn" class="btn-secondary">Refresh</button>
            </div>
            <p class="hint" id="ollama-models-status" data-provider-field="ollama-model"></p>
            <p class="hint" data-provider-field="goose">Leave blank to use Goose's currently configured model.</p>
        </div>

        <div class="field field-inline">
            <input type="checkbox" id="isEnabled" asp-for="Input.IsEnabled" />
            <label for="isEnabled">Enable AI agent integration</label>
        </div>

        <button type="submit" class="btn-primary">Save Settings</button>
    </form>
</div>

<script>
    (function () {
        var providerSelect = document.getElementById('provider');
        var cloudFields = document.querySelectorAll('[data-provider-field="cloud"]');
        var localBinFields = document.querySelectorAll('[data-provider-field="localbin"]');
        var gooseOnlyFields = document.querySelectorAll('[data-provider-field="goose"]');
        var textModelFields = document.querySelectorAll('[data-provider-field="text-model"]');
        var ollamaModelFields = document.querySelectorAll('[data-provider-field="ollama-model"]');
        var baseUrlInput = document.getElementById('baseUrl');
        var modelInput = document.getElementById('model');
        var modelSelect = document.getElementById('model-select');
        var refreshBtn = document.getElementById('refresh-models-btn');
        var statusEl = document.getElementById('ollama-models-status');
        var checkGooseBtn = document.getElementById('check-goose-btn');
        var gooseStatusEl = document.getElementById('goose-status');

        function toggle(elements, show) {
            elements.forEach(function (el) { el.style.display = show ? '' : 'none'; });
        }

        function sync() {
            var provider = providerSelect.value;
            var isOllama = provider === 'Ollama';
            var isGoose = provider === 'GooseCli';

            toggle(cloudFields, !isOllama && !isGoose);
            toggle(localBinFields, isOllama || isGoose);
            toggle(gooseOnlyFields, isGoose);
            toggle(textModelFields, !isOllama);
            toggle(ollamaModelFields, isOllama);

            baseUrlInput.placeholder = isGoose ? 'http://127.0.0.1:3284 (leave blank for default)' : 'http://localhost:11434';
        }

        function populateSelect(models, selected) {
            modelSelect.innerHTML = '';

            if (selected && models.indexOf(selected) === -1) {
                models = [selected].concat(models);
            }

            if (models.length === 0) {
                var placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.textContent = 'No models found';
                modelSelect.appendChild(placeholder);
                return;
            }

            models.forEach(function (name) {
                var option = document.createElement('option');
                option.value = name;
                option.textContent = name;
                if (name === selected) {
                    option.selected = true;
                }
                modelSelect.appendChild(option);
            });
        }

        function loadModels() {
            var baseUrl = baseUrlInput.value.trim();
            if (!baseUrl) {
                statusEl.textContent = 'Enter an endpoint URL first.';
                return;
            }

            statusEl.textContent = 'Loading models…';
            fetch('/api/ai-settings/ollama-models?baseUrl=' + encodeURIComponent(baseUrl))
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                    }
                    return response.json();
                })
                .then(function (models) {
                    populateSelect(models, modelInput.value);
                    statusEl.textContent = models.length
                        ? models.length + ' model(s) found.'
                        : 'No models found on this endpoint.';
                })
                .catch(function () {
                    populateSelect([], modelInput.value);
                    statusEl.textContent = 'Could not reach the Ollama endpoint.';
                });
        }

        function checkGoose() {
            gooseStatusEl.textContent = 'Checking…';
            fetch('/api/ai-settings/goose-cli-status?endpoint=' + encodeURIComponent(baseUrlInput.value.trim()))
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                    }
                    return response.json();
                })
                .then(function (status) {
                    gooseStatusEl.textContent = status.isAvailable
                        ? 'Goose agent reachable (' + (status.version || 'version unknown') + ').'
                        : 'Could not reach the Goose serve endpoint: ' + (status.error || 'unknown error');
                })
                .catch(function () {
                    gooseStatusEl.textContent = 'Could not reach the Goose serve endpoint.';
                });
        }

        modelSelect.addEventListener('change', function () {
            modelInput.value = modelSelect.value;
        });

        refreshBtn.addEventListener('click', loadModels);
        checkGooseBtn.addEventListener('click', checkGoose);

        baseUrlInput.addEventListener('blur', function () {
            if (providerSelect.value === 'Ollama') {
                loadModels();
            } else if (providerSelect.value === 'GooseCli') {
                checkGoose();
            }
        });

        providerSelect.addEventListener('change', function () {
            sync();
            if (providerSelect.value === 'Ollama') {
                loadModels();
            } else if (providerSelect.value === 'GooseCli') {
                checkGoose();
            }
        });

        sync();

        if (providerSelect.value === 'Ollama') {
            populateSelect([], modelInput.value);
            if (baseUrlInput.value.trim()) {
                loadModels();
            }
        } else if (providerSelect.value === 'GooseCli') {
            checkGoose();
        }
    })();
</script>
