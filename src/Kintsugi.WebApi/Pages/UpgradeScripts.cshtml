@page "/upgrade-scripts"
@model Kintsugi.WebApi.Pages.UpgradeScriptsModel
@{
    ViewData["Title"] = "Upgrade Scripts";
    ViewData["ActiveNav"] = "sync.upgrade-scripts";
}

<div class="section-header">
    <div>
        <h2>Upgrade Scripts</h2>
        <p class="hint">
            Every upgrade script an agent could run, and whether a human has approved it. An
            unapproved script is one no agent will execute: each agent verifies the signature against
            the key it pinned at enrollment before running anything, so "unsigned" means inert rather
            than trusted. Scripts are reviewed and signed on the
            <a href="/applications">Applications</a> page.
        </p>
        <p class="hint">
            Approvals are shared through <code>@Model.Overview.Repository</code>. Signing a script here
            opens a pull request against it; merging that pull request is what makes the approval
            available to every other Kintsugi server. "Refresh scripts" reads that branch back and
            signs any local script whose bytes are already approved there.
        </p>
    </div>
    <div class="button-row">
        <form method="post" asp-page-handler="Refresh">
            <button type="submit" class="btn-primary">Refresh scripts</button>
        </form>
    </div>
</div>

@if (!Model.Overview.PublishingEnabled)
{
    @* Said out loud for the same reason the Clients page announces a derived AGENT_API_BASE_URL: the
       failure is invisible otherwise. Signing keeps working, so nothing looks wrong — an operator
       would only find out that no audit trail exists by going to look for pull requests that were
       never opened. *@
    <div class="alert alert-info">
        No <code>SCRIPT_APPROVAL_GITHUB_TOKEN</code> is configured, so signing a script approves it on
        this server only — no pull request is raised, nothing is recorded in
        <code>@Model.Overview.Repository</code>, and no other server can pick the approval up. Reading
        the approved corpus still works; only publishing needs the token.
    </div>
}

@if (Model.RefreshError is not null)
{
    <div class="alert alert-error">Could not refresh from @Model.Overview.Repository: @Model.RefreshError</div>
}
else if (Model.Overview.UnavailableReason is not null)
{
    @* A note beside a working page, not an error in place of one: already-imported approvals and
       already-signed local scripts are unaffected by GitHub being unreachable. *@
    <div class="alert alert-info">
        Could not read @Model.Overview.Repository: @Model.Overview.UnavailableReason
    </div>
}

@if (Model.AdoptError is not null)
{
    <div class="alert alert-error">Could not adopt that script: @Model.AdoptError</div>
}
else if (Model.Adopted is not null)
{
    <div class="alert alert-success">
        Adopted the approved script for @Model.Adopted.ApplicationName on @Model.Adopted.Platform and
        signed it with this server's key.
    </div>
}

@if (Model.TakeServerScriptError is not null)
{
    <div class="alert alert-error">Could not take the newer script: @Model.TakeServerScriptError</div>
}
else if (Model.TookServerScript is { } took)
{
    @if (took.Changed)
    {
        <div class="alert alert-success">
            @took.ApplicationName on @took.Platform now holds the script this server writes, and is
            <strong>awaiting review</strong> — no agent will run it until it is signed. Signing it
            covers every other row holding the same content.
        </div>
    }
    else
    {
        <div class="alert alert-success">
            @took.ApplicationName on @took.Platform already holds the script this server writes;
            nothing changed.
        </div>
    }
}

@if (Model.ImportResult is { } import)
{
    <div class="alert alert-success">
        Read @Model.Overview.Repository at
        <code>@(import.CommitSha is null ? "?" : import.CommitSha[..Math.Min(12, import.CommitSha.Length)])</code>:
        @import.Imported newly imported, @import.AlreadyKnown already known.
    </div>

    @if (import.Blessed.Count > 0)
    {
        @* Distinguished from adoption in the wording, because the distinction is the whole safety
           argument: nothing arrived, an existing local script was recognised as already reviewed. *@
        <div class="alert alert-success">
            Signed @import.Blessed.Count local script(s) whose content was already approved upstream —
            no script text changed:
            @string.Join(", ", import.Blessed.Select(b => $"{b.ApplicationName} on {b.Platform}")).
        </div>
    }

    @foreach (var reason in import.Rejected)
    {
        <div class="alert alert-error">Skipped: @reason</div>
    }
}

<div class="panel">
    <p class="hint">
        This server signs as <code>@Model.Overview.ThisServerFingerprint</code>. That is the only
        fingerprint whose signatures are verified against a key this server holds; every other
        signer's public key travels in the approval repository alongside the script it vouches for, so
        a signature from one shows who claims to have reviewed a script, not that they were authorized
        to. Authorization is the repository's branch protection on
        <code>@(Model.Overview.DefaultBranch ?? "the default branch")</code>.
    </p>
</div>

<h3>Local scripts</h3>
@if (Model.Overview.AwaitingReview > 0)
{
    @* The only number on this page representing work outstanding: until a human signs these, no
       agent will run them, so an application with an unsigned script does not patch at all. *@
    <div class="alert alert-info">
        @Model.Overview.AwaitingReview script(s) are waiting for review. Until one is signed no agent
        will run it, so those applications are not patching. Review and sign them on the
        <a href="/applications">Applications</a> page.
    </div>
}
@if (Model.Overview.NewerServerScripts > 0)
{
    @* Deliberately not phrased as work outstanding: these rows are signed and patching normally.
       A signed script is never replaced by a deployment (see RegisterApplicationsCommandHandler),
       so this is the only thing that says a newer one exists. *@
    <div class="alert alert-info">
        @Model.Overview.NewerServerScripts signed row(s) hold a script this server no longer writes —
        one of its package-manager scripts has been changed since they were reviewed. They keep
        running the text that was approved, and go on patching, until someone takes the newer one
        below. Taking it leaves that row unsigned until it is reviewed and signed.
    </div>
}
@if (Model.Overview.LocalScripts.Count == 0)
{
    <div class="panel">
        <p class="empty">No upgrade scripts have been resolved yet. Use "Find Upgrade Paths" on the Applications page.</p>
    </div>
}
else
{
    <div class="panel table-panel">
        <table>
            <thead>
                <tr>
                    <th>Application</th>
                    <th>Platform</th>
                    <th>Content</th>
                    <th>Approved here</th>
                    <th>Approved upstream</th>
                    <th>Server script</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var script in Model.Overview.LocalScripts)
                {
                    <tr>
                        <td>@script.ApplicationName</td>
                        <td>@script.Platform</td>
                        <td class="muted-text"><code>@script.Sha256[..12]</code></td>
                        <td>
                            @if (script.Signed)
                            {
                                <span class="status status-up-to-date">Signed</span>
                            }
                            else
                            {
                                <span class="status status-update-available">Review and sign</span>
                            }
                        </td>
                        <td>
                            @if (script.ApprovedUpstream)
                            {
                                <span class="status status-up-to-date">Yes</span>
                            }
                            else
                            {
                                <span class="muted-text">—</span>
                            }
                        </td>
                        <td class="actions">
                            @if (script.NewerServerScriptAvailable)
                            {
                                @* The row keeps running its reviewed script until this is pressed —
                                   see RegisterApplicationsCommandHandler for why nothing does it by
                                   itself. Taking it leaves the row unsigned, so the button says so
                                   rather than implying the new text goes live on click. *@
                                <form method="post" asp-page-handler="TakeServerScript">
                                    <input type="hidden" name="applicationName" value="@script.ApplicationName" />
                                    <input type="hidden" name="platform" value="@script.Platform" />
                                    <button type="submit" class="btn-secondary">Take newer, for review</button>
                                </form>
                            }
                            else
                            {
                                <span class="muted-text">Current</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h3>Approved scripts available to adopt</h3>
<p class="hint">
    Scripts approved elsewhere for an application this server has no approved script for. Adopting one
    copies its content onto that upgrade path and signs it with this server's key, because every agent
    pins one signing key and it is its own server's — a remote signature would be genuine and still
    refused. Check the signer before adopting: merging to
    <code>@(Model.Overview.DefaultBranch ?? "the default branch")</code> is what puts an entry in this
    list, so this button is the last human decision before agents run the script as root.
</p>
@if (Model.Overview.AdoptionCandidates.Count == 0)
{
    <div class="panel">
        <p class="empty">Nothing to adopt. Every local upgrade path either has an approved script or has no approved counterpart upstream.</p>
    </div>
}
else
{
    <div class="panel table-panel">
        <table>
            <thead>
                <tr>
                    <th>Application</th>
                    <th>Platform</th>
                    <th>Content</th>
                    <th>Signer</th>
                    <th>Signed by</th>
                    <th>Approved</th>
                    <th class="actions">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var candidate in Model.Overview.AdoptionCandidates)
                {
                    <tr>
                        <td>@candidate.ApplicationName</td>
                        <td>@candidate.Platform</td>
                        <td class="muted-text"><code>@candidate.Sha256[..12]</code></td>
                        <td>
                            @if (candidate.IsThisServer)
                            {
                                <span class="status status-up-to-date">This server</span>
                            }
                            else
                            {
                                <code class="muted-text">@candidate.SignerFingerprint[..Math.Min(19, candidate.SignerFingerprint.Length)]</code>
                            }
                        </td>
                        <td class="muted-text">@(candidate.SignedBy ?? "—")</td>
                        <td class="muted-text"><time data-utc="@candidate.ApprovedAtUtc.ToString("o")">@candidate.ApprovedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</time></td>
                        <td class="actions">
                            <form method="post" asp-page-handler="Adopt">
                                <input type="hidden" name="applicationName" value="@candidate.ApplicationName" />
                                <input type="hidden" name="platform" value="@candidate.Platform" />
                                <input type="hidden" name="sha256" value="@candidate.Sha256" />
                                <input type="hidden" name="signerFingerprint" value="@candidate.SignerFingerprint" />
                                @* The label changes when there is unsigned local content to lose. No
                                   agent is running it — the row is unsigned either way — but someone
                                   who hand-wrote a script here and hasn't signed it yet should not
                                   discover that from the result. *@
                                <button type="submit" class="btn-secondary">
                                    @(candidate.ReplacesExistingScript ? "Replace and adopt" : "Adopt")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h3>Imported approvals</h3>
@if (Model.Overview.Approved.Count == 0)
{
    <div class="panel">
        <p class="empty">Nothing has been imported from @Model.Overview.Repository yet. Use "Refresh scripts".</p>
    </div>
}
else
{
    <div class="panel table-panel">
        <table>
            <thead>
                <tr>
                    <th>Application</th>
                    <th>Bucket</th>
                    <th>Content</th>
                    <th>Signer</th>
                    <th>Signed by</th>
                    <th>In use here</th>
                    <th>From commit</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var approved in Model.Overview.Approved)
                {
                    <tr>
                        <td>@approved.ApplicationName</td>
                        <td>@approved.PlatformBucket</td>
                        <td class="muted-text"><code>@approved.Sha256[..12]</code></td>
                        <td>
                            @if (approved.IsThisServer)
                            {
                                <span class="status status-up-to-date">This server</span>
                            }
                            else
                            {
                                <code class="muted-text">@approved.SignerFingerprint[..Math.Min(19, approved.SignerFingerprint.Length)]</code>
                            }
                        </td>
                        <td class="muted-text">@(approved.SignedBy ?? "—")</td>
                        <td>
                            @if (approved.HeldLocally)
                            {
                                <span class="status status-up-to-date">Yes</span>
                            }
                            else
                            {
                                <span class="muted-text">—</span>
                            }
                        </td>
                        <td class="muted-text"><code>@approved.SourceCommitSha[..Math.Min(12, approved.SourceCommitSha.Length)]</code></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
